#include <stdio.h>
//#include <stdlib.h>

//int     atexit(void ( *)(void));

int count1;

main()
{
  int item[100];
  int a,b,t;
  int count;
  /* read in numbers */
  printf("How many numbers ?");
  scanf("%d", &count);
  for (a=0;a<count;a++) scanf("%d", &item[a]);

  /* now sort using bubble sort */
  for ( a = 0; a < count - 1; ++a )
  {
	  for ( b = a + 1; b < count; ++b )
	  {
		  if ( item[ a ] > item[ b ] )
		  {
			  t = item[ a ];
			  item[ a ] = item[ b ];
			  item[ b ] = t;
		  }
	  }
  }

  printf( "\n" );
  /* display sorted list */
  for (t=0; t<count; ++t)  
  {
  	 printf("%d\n", item[t]);
  }
}